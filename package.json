{
  "name": "clang-tools-npm",
  "private": true,
  "description": "Builds and publishes the @cpp-linter/clang-format and @cpp-linter/clang-tidy npm packages",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke": "node test/smoke.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-include='scripts/**' --test-coverage-include='templates/main/**' --test-coverage-lines=100 --test-coverage-functions=100 test/*.test.mjs",
    "publish-packages": "node scripts/publish.mjs"
  }
}
